{
  "ashford": [
    {
      "id": "ev_refugees",
      "w": 3,
      "text": "一支新的流民队伍进了镇。镇民们围在广场，递水的递水，让棚的让棚。人群里有人低声说起东边的天。",
      "discovery": null
    },
    {
      "id": "ev_festival",
      "w": 2,
      "text": "镇民在广场扎丰收节的彩棚。玛尔塔叉着腰数落帮工：酒不够，全都不合格。"
    },
    {
      "id": "ev_recruiter",
      "w": 2,
      "text": "银棘骑士团的征募官在广场停留半日，铠甲擦得能照见人。他谈论起圣辉城的选拔，像在谈论另一个世界的事。"
    },
    {
      "id": "ev_caravan_arrive",
      "w": 2,
      "text": "西边来的商队进了镇，带来王都的新货和更新的物价。艾达的店里难得地摆满了药水。"
    },
    {
      "id": "ev_rainy_night",
      "w": 1,
      "text": "雨下了一夜。酒馆里人格外多，壁炉烧得噼啪响，讲故事的声音一直没停。"
    },
    {
      "id": "ev_af_201",
      "w": 2,
      "node": "smithy",
      "text": "铁匠铺里火星四溅。布洛姆正给农户修一把锄头，敲两下，眯眼看一下，敲两下。凯因趴在门边看了一下午，布洛姆头也不回：'再看，再看收你学费。'"
    },
    {
      "id": "ev_af_202",
      "w": 2,
      "node": "tavern",
      "text": "酒馆角落，莱恩的指尖在桌面上虚拨着一根不存在的弦。唱到某一段，他的手指停住了，那里本来有个和弦。玛尔塔路过，把一杯麦酒墩在他手边，什么都没说。"
    },
    {
      "id": "ev_af_203",
      "w": 2,
      "node": "square",
      "text": "流民老妇人的摊子前围了几个孩子，捏着铜板比划要哪只草蚂蚱。她给每个孩子都多编了一条腿，嘴里念叨：'六条腿的，跑得快，能把坏运气蹬在后头。'"
    },
    {
      "id": "ev_af_204",
      "w": 1,
      "night_only": true,
      "node": "shop",
      "text": "深夜的杂货店还亮着灯。艾达伏在柜台上对账，算珠拨得噼啪响，拨着拨着停下来，把一笔'商队损失'划掉，改记成了'收不回来'。"
    },
    {
      "id": "ev_af_205",
      "w": 2,
      "node": "gate",
      "text": "清晨的镇门，一支去雾帷森林方向的商队正在套骡。车把式检查着第三遍绳索，一个流民汉子默默上前，替他把松脱的绳结重新打了。两人谁也没说话，末了碰了碰拳头。"
    }
  ],
  "mistwood": [
    {
      "id": "ev_wolves",
      "w": 3,
      "battle": {
        "monster": "wolf",
        "count": [
          1,
          3
        ]
      },
      "text": "雾里传来踩断枯枝的声响——森林狼，{count} 只，眼睛在雾中泛着黄光。"
    },
    {
      "id": "ev_lost",
      "w": 2,
      "weather_boost": {
        "fog": 3
      },
      "effect": {
        "food": -1,
        "water": -1
      },
      "text": "雾忽然浓了。你在原地转了不知多久，直到踩到自己方才折断的枝条——兜了一个大圈。干粮和水都耗了些。"
    },
    {
      "id": "ev_herb_spot",
      "w": 2,
      "weather_boost": {
        "clear": 2
      },
      "gather": [
        "herb_mist",
        "moss_stanch"
      ],
      "text": "雾散开一小片，露出树根处的几丛小草：银边的雾绒草，还有几株止血苔。"
    },
    {
      "id": "ev_deer",
      "w": 2,
      "text": "一群林鹿从雾中穿过，蹄声轻得像雨。它们看了你一眼，并不怕你——这片林子不是你的，也不是它们的。"
    },
    {
      "id": "ev_trap",
      "w": 1,
      "effect": {
        "hp": -3
      },
      "text": "脚踝一紧——加洛布下的旧捕兽夹，锈了大半，还是咬得人生疼。你在夹子上看到加洛的刻记。"
    },
    {
      "id": "ev_spider",
      "w": 1,
      "node": "deep_mist",
      "weather_boost": {
        "rain": 2
      },
      "battle": {
        "monster": "mistspider",
        "count": [
          1,
          2
        ]
      },
      "text": "头顶的雾丝垂了下来——不是雾。雾行蛛从树冠间滑落，{count} 只，腹部凝着水珠。"
    },
    {
      "id": "ev_moss_glow",
      "w": 1,
      "node": "deep_mist",
      "flag": "moss_glow_seen",
      "text": "雾气深处透出一层极淡的青光，像月亮沉在了林子底下。你记下这个方位。"
    },
    {
      "id": "ev_crying_villager",
      "w": 1,
      "node": "forest_edge",
      "once_flag": "met_crying_villager",
      "quest_hook": "q_d_child",
      "text": "林缘传来哭声。一个村妇瘫坐在路边，抓着过路人——也就是你——的袖子：她的儿子小荞追着'发光的小鹿'跑进林子，已经半天了。"
    },
    {
      "id": "ev_mw_101",
      "w": 3,
      "battle": {
        "monster": "wolf",
        "count": [
          2,
          3
        ]
      },
      "text": "雾里响起一串极轻的碎步，踩得极有章法——{count} 只森林狼贴着雾的边缘游弋，黄眼睛一明一灭，始终与你保持着十步的距离。"
    },
    {
      "id": "ev_mw_102",
      "w": 3,
      "node": "deep_mist",
      "weather_boost": {
        "rain": 2
      },
      "battle": {
        "monster": "mistspider",
        "count": [
          1,
          2
        ]
      },
      "text": "雨把树冠浇得沉甸甸的，雾丝一根根垂到眼前——雾行蛛借雨丝滑降，{count} 只，水亮的腹部吊在丝上，缓缓地转。"
    },
    {
      "id": "ev_mw_103",
      "w": 2,
      "node": "watchtower",
      "weather_boost": {
        "fog": 2
      },
      "battle": {
        "monster": "wolf",
        "count": [
          1,
          3
        ]
      },
      "text": "废弃哨塔的基座下传来爪刮石面的声响——{count} 只森林狼把旧哨塔当成了巢，你的靴子声刚落，暗影里便亮起一片黄光。"
    },
    {
      "id": "ev_mw_104",
      "w": 2,
      "node": "forest_edge",
      "battle": {
        "monster": "goblin",
        "count": [
          1,
          3
        ]
      },
      "text": "采药小径的岔口有拖拽的痕迹，碎树皮撒了一路——{count} 只哥布林正围着一只破背篓翻检，听见脚步，绿脸齐刷刷抬了起来。"
    },
    {
      "id": "ev_mw_105",
      "w": 2,
      "node": "hunter_hut",
      "weather_boost": {
        "clear": 2
      },
      "gather": [
        "herb_mist",
        "moss_stanch"
      ],
      "text": "猎户小屋背后立着加洛的草药架，架上空着，架脚的新土却冒出一丛丛银边雾绒草，草缝间还趴着两片止血苔。他常说，谁采到就是谁的。"
    },
    {
      "id": "ev_mw_106",
      "w": 2,
      "node": "deep_mist",
      "night_only": true,
      "gather": [
        "moss_moon"
      ],
      "text": "夜里的雾透着一线青。一棵老树根的背阴面，一小片月光苔正幽幽地亮，像谁把一小角月亮按进了苔里。你采下最厚的几簇，指尖沾了光的凉。"
    },
    {
      "id": "ev_mw_107",
      "w": 2,
      "node": "forest_edge",
      "weather_boost": {
        "rain": 2
      },
      "gather": [
        "moss_stanch"
      ],
      "text": "雨后的倒木滑得站不住脚，木背面的苔衣却肥了一层——几株止血苔吸饱了水，指尖一掐就断，断口渗出清亮的汁。"
    },
    {
      "id": "ev_mw_108",
      "w": 1,
      "weather_boost": {
        "fog": 3
      },
      "effect": {
        "hp": -4
      },
      "text": "浓雾里一根断枝横在小径齐膝的高度。你撞个正着，枝子弹起抽在小腿上，疼得倒吸凉气——这路加洛走过千百遍，唯独没修过这根枝。"
    },
    {
      "id": "ev_mw_109",
      "w": 2,
      "node": "clearing",
      "weather_boost": {
        "clear": 2
      },
      "text": "一只林鹿卧在空地的阳光里反刍，看见你也不起身，只把耳朵转向你来的方向。它背上落着一层金色的光斑，像披了件旧斗篷。"
    },
    {
      "id": "ev_mw_110",
      "w": 1,
      "weather_boost": {
        "fog": 2
      },
      "text": "雾把声音揉乱了：左近的鹿鸣听着像从头顶传来，三步外的滴水声倒像在天边。你索性停下脚步，等耳朵自己适应这片林子。"
    },
    {
      "id": "ev_mw_111",
      "w": 1,
      "node": "watchtower",
      "night_only": true,
      "text": "夜里的哨塔只剩半截，塔顶残杆上悬着一串兽牙风铃，被风推着一下一下磕在石柱上。加洛年轻时挂的，牙都磨得发了白。"
    },
    {
      "id": "ev_mw_112",
      "w": 1,
      "weather_boost": {
        "fog": 3
      },
      "night_only": true,
      "text": "雾深处悬着两点幽绿，不靠近，也不退开。对视了很久，那双眼睛忽然垂下去——灰鬃打了个哈欠，转身没入雾中，像路过一件不值一提的东西。"
    }
  ],
  "lavarift": [
    {
      "id": "ev_salamander",
      "w": 3,
      "battle": {
        "monster": "firesalamander",
        "count": [
          1,
          2
        ]
      },
      "text": "岩缝里的影子动了——火蜥蜴，{count} 只，受惊的鳞片一路烧成赤红。"
    },
    {
      "id": "ev_ore_vein",
      "w": 2,
      "weather_boost": {
        "clear": 2
      },
      "gather": [
        "ore_fire",
        "sulfur"
      ],
      "text": "一片岩壁在热气里泛着暗红纹路：火纹矿的露头，旁边还结着硫磺。"
    },
    {
      "id": "ev_heat_burst",
      "w": 2,
      "effect": {
        "hp": -4
      },
      "text": "脚下的岩缝毫无预兆地喷出一股热气，灼得你踉跄退开，胳膊上火辣辣一片。"
    },
    {
      "id": "ev_miners_song",
      "w": 2,
      "text": "夜班的矿工下班了，歌声顺着坡道传上来，干巴巴的调子，唱着矿灯、烈酒和某个欠了赌债的兄弟。"
    },
    {
      "id": "ev_scorpion",
      "w": 1,
      "node": "obsidian_slope",
      "battle": {
        "monster": "rockscorpion",
        "count": [
          1,
          1
        ]
      },
      "text": "脚边那块'黑曜石'忽然立了起来——岩壳蝎，尾针在热空气里划出弧线。"
    },
    {
      "id": "ev_ash_mark",
      "w": 1,
      "night_only": true,
      "flag": "ash_mark_seen",
      "discovery": "ash_mark",
      "text": "矿灯扫过岩壁，你停住了：一小撮灰，被摆成小小的人形，立在你从未走过的岔道口。你没来由地觉得，它是摆给你看的。"
    },
    {
      "id": "ev_elemental_weak",
      "w": 1,
      "node": "lava_depths",
      "battle": {
        "monster": "firesalamander",
        "count": [
          2,
          2
        ]
      },
      "text": "岩浆层方向涌来一阵异常的热浪，两只火蜥蜴被惊得疯了一般冲上来。"
    },
    {
      "id": "ev_scale_glow",
      "w": 1,
      "node": "lava_depths",
      "once_flag": "scale_glow_seen",
      "text": "热雾深处，有一道暗金色的反光一闪而过，沉稳，古老，不像矿石。你记下这个方位。"
    },
    {
      "id": "ev_lr_201",
      "w": 3,
      "node": "miner_camp",
      "battle": {
        "monster": "firesalamander",
        "count": [
          1,
          2
        ]
      },
      "text": "营地背后的矿渣堆忽然塌了一角——火蜥蜴把滚烫的渣堆当成了窝，{count} 只，受惊的鳞片一路烧成赤红。黛拉抄起撬棍，比你先动了。"
    },
    {
      "id": "ev_lr_202",
      "w": 3,
      "node": "rift_edge",
      "battle": {
        "monster": "rockscorpion",
        "count": [
          1,
          2
        ]
      },
      "text": "裂谷边缘的石滩上，几块'石头'同时立了起来——岩壳蝎，{count} 只，黑曜石的外壳上还烫得能烙熟指尖。"
    },
    {
      "id": "ev_lr_203",
      "w": 3,
      "node": "lava_depths",
      "battle": {
        "monster": "fireelemental",
        "count": [
          1,
          1
        ]
      },
      "text": "矿道尽头的热浪忽然凝成了形——{count} 只失控火元素，没有眼睛，你却觉得它在看着你烧。它走过的地方，岩壁上的水汽嘶嘶地逃。"
    },
    {
      "id": "ev_lr_204",
      "w": 3,
      "battle": {
        "monster": "firesalamander",
        "count": [
          1,
          3
        ]
      },
      "text": "坡道下方的黑岩一片接一片地亮起红点——火蜥蜴，{count} 只，被你的脚步声惊动，正顺着岩壁爬上来。"
    },
    {
      "id": "ev_lr_205",
      "w": 2,
      "gather": [
        "sulfur"
      ],
      "text": "黑曜石坡道背阴的一侧凝着一层鲜黄的结晶，呛得你偏过头去——是硫磺，品质极好，矿工们管这叫'老天的糠'。"
    },
    {
      "id": "ev_lr_206",
      "w": 2,
      "weather_boost": {
        "clear": 2
      },
      "gather": [
        "ore_fire"
      ],
      "text": "晴天的热气把岩层纹路照得一清二楚：一道火纹矿脉斜插进坡壁，断口处泛着暗红，握在手里是温的。"
    },
    {
      "id": "ev_lr_207",
      "w": 2,
      "node": "lava_depths",
      "gather": [
        "ore_fire",
        "sulfur"
      ],
      "text": "废弃矿道的支架下，塌方露出了一小片矿囊：火纹矿的原石混着硫磺晶，在谷底红光里一闪一闪，像埋了一小把炭。"
    },
    {
      "id": "ev_lr_208",
      "w": 2,
      "effect": {
        "hp": -5
      },
      "text": "头顶的岩檐毫无预兆地崩下一片碎渣，烫的。你抬臂挡了一下，小臂上立刻燎起一串红泡，硫磺味糊了满鼻腔。"
    },
    {
      "id": "ev_lr_209",
      "w": 2,
      "text": "下矿的队伍从你身旁走过，矿灯在腰上一晃一晃。谷底的红光自下而上打在每个人脸上，把每一张脸都映成陌生的颜色。没人说话，只有皮靴碾过碎石的声音。"
    },
    {
      "id": "ev_lr_210",
      "w": 1,
      "night_only": true,
      "rumor": true,
      "text": "夜班收工后，几个矿工围着火堆压低了声音。有人赌咒说上月在废矿道里见过新鲜的标记，有人赌咒说丢过一整筐火纹矿。说到灰烬会三个字，火堆恰好炸开一颗火星，谁都不再接话了。"
    },
    {
      "id": "ev_lr_211",
      "w": 2,
      "weather_boost": {
        "cold": 2
      },
      "text": "寒潮天，裂谷的风难得不烫脸。黛拉站在营地口深吸了一口气，难得地笑：'好天气。一年里就这几天，这鬼地方待得住人。'"
    },
    {
      "id": "ev_lr_212",
      "w": 1,
      "effect": {
        "food": -1,
        "water": -1
      },
      "text": "午后的热气从谷底一层层涌上来，鞋底很快烫得站不住。你找个背阴处歇脚，水壶以可见的速度变轻，干粮也干得难以下咽。"
    }
  ],
  "thunderpass": [
    {
